# Perry's Intelligent Workbench (Chemie.ai4U.now) — server-only environment contract.
# Copy to `.env` for local runs. Zero real secrets are ever committed (repo invariant #3).

# Tier-2 AI gateway (gemini-4-argon-low). Leave GATEWAY_API_KEY EMPTY to force the
# deterministic Tier-1 ChE Tutor fallback (same behavior as zero-key / Vitest runs).
GATEWAY_URL=https://gateway.ai4u.now
GATEWAY_API_KEY= # guard:allow-env-credential
GATEWAY_MODEL=gemini-4-argon-low

# Deterministic Perry sidecar (FastAPI + PyMuPDF) — proxied via /api/v1/* and /api/perry/*.
PERRY_SIDECAR_URL=http://127.0.0.1:8001

# Express host (vite dev proxy targets http://127.0.0.1:3000).
# PORT=3000
